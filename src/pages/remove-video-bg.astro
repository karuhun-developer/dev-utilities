---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Video Background Remover (WebGPU)"
	description="Remove or replace backgrounds from videos in your browser with WebGPU-accelerated AI or Chroma Key. 100% private, free, and client-side."
	keywords="video background remover, remove video background, transparent webm, chroma key, green screen removal, webgpu video ai, client side video background removal"
>
	<div class="max-w-6xl" x-data="removeVideoBgApp()" x-init="init()">
		<!-- Header -->
		<div class="flex flex-wrap items-center justify-between gap-4 mb-2">
			<div class="flex items-center gap-3">
				<h1 class="text-2xl font-bold text-zinc-900">Video Background Remover</h1>
				<span class="text-xs font-semibold px-2.5 py-0.5 bg-purple-50 text-purple-700 border border-purple-200 rounded-full">
					WebGPU Powered
				</span>
			</div>
			<!-- Hardware Status Badge -->
			<div class="flex items-center gap-2">
				<template x-if="isCheckingGpu">
					<span class="text-xs font-medium px-2.5 py-1 bg-zinc-100 text-zinc-500 rounded-full border border-zinc-200 flex items-center gap-1.5">
						<svg class="animate-spin w-3 h-3 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
						Probing WebGPU...
					</span>
				</template>
				<template x-if="!isCheckingGpu && hasWebGpu">
					<span class="text-xs font-semibold px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200 flex items-center gap-1.5 shadow-xs" title="WebGPU hardware acceleration is active">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
						⚡ WebGPU Ready <span x-show="hasFp16" class="text-[10px] bg-emerald-200 text-emerald-900 px-1 py-0.2 rounded font-mono">+FP16</span>
					</span>
				</template>
				<template x-if="!isCheckingGpu && !hasWebGpu">
					<span class="text-xs font-semibold px-2.5 py-1 bg-amber-50 text-amber-800 rounded-full border border-amber-200 flex items-center gap-1.5" title="WebGPU is not detected in this browser">
						<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
						⚠️ WebGPU Unavailable
					</span>
				</template>
			</div>
		</div>

		<p class="text-zinc-600 mb-6">
			Erase or replace backgrounds from video clips locally inside your browser. No files are uploaded to any server. AI mode utilizes high-performance WebGPU acceleration.
		</p>

		<!-- WebGPU Missing Alert Banner (shown if browser has no WebGPU) -->
		<div x-show="!isCheckingGpu && !hasWebGpu" style="display:none;" class="mb-6 bg-amber-50 border border-amber-200 text-amber-900 rounded-2xl p-4 flex items-start gap-3">
			<svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
			</svg>
			<div class="text-xs leading-relaxed space-y-1">
				<p class="font-bold text-sm text-amber-950">WebGPU is Required for AI Video Removal</p>
				<p>
					Processing hundreds of video frames with AI requires WebGPU hardware acceleration, which was not detected on your browser or device.
					<strong class="font-semibold">AI Video Removal mode is disabled.</strong>
				</p>
				<p class="text-amber-800">
					💡 <strong>How to enable WebGPU:</strong> Use an updated Google Chrome, Microsoft Edge, or Chromium browser. Ensure "Hardware Acceleration" is enabled in browser settings (<code class="bg-amber-100 px-1 py-0.5 rounded text-[11px]">chrome://settings/system</code>).
				</p>
				<p class="pt-0.5 font-medium text-amber-900">
					✅ You can still use the <strong class="underline decoration-amber-500">Green Screen / Chroma Key</strong> mode below, which works 100% on any browser without WebGPU!
				</p>
			</div>
		</div>

		<!-- Upload Zone (shown when no video is loaded) -->
		<div
			x-show="!videoSrc"
			class="relative flex flex-col items-center justify-center border-2 border-dashed rounded-2xl px-8 py-12 text-center transition-all cursor-pointer mb-6"
			:class="isDragging ? 'border-zinc-600 bg-zinc-100' : 'border-zinc-300 bg-zinc-50 hover:bg-zinc-100 hover:border-zinc-400'"
			@dragover.prevent="isDragging = true"
			@dragleave.prevent="isDragging = false"
			@drop.prevent="onDrop($event)"
			@click="$refs.videoInput.click()"
		>
			<div class="w-14 h-14 rounded-2xl bg-zinc-200/60 flex items-center justify-center text-zinc-700 mb-4 shadow-xs">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
				</svg>
			</div>
			<p class="text-base font-semibold text-zinc-800">Drop a video here or <span class="text-zinc-900 underline underline-offset-2">browse file</span></p>
			<p class="text-xs text-zinc-400 mt-1">MP4 · WEBM · MOV · Recommended: short clips (1–15 seconds) for faster processing</p>
			<input
				type="file"
				accept="video/mp4,video/webm,video/quicktime"
				class="sr-only"
				x-ref="videoInput"
				@change="onFileChange($event)"
			/>
		</div>

		<!-- Workspace (shown when video is loaded) -->
		<div x-show="videoSrc" style="display:none;" class="space-y-6">
			
			<!-- Video File Info Bar -->
			<div class="bg-white border border-zinc-200 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4 shadow-xs">
				<div class="flex items-center gap-3 min-w-0">
					<div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
					</div>
					<div class="min-w-0">
						<p class="text-sm font-semibold text-zinc-900 truncate" x-text="videoFile?.name || 'video'"></p>
						<div class="flex items-center gap-2 text-xs text-zinc-500 mt-0.5">
							<span x-text="formatDuration(duration)"></span>
							<span>·</span>
							<span x-text="videoWidth + ' × ' + videoHeight + ' px'"></span>
							<span>·</span>
							<span x-text="formatSize(videoFile?.size || 0)"></span>
						</div>
					</div>
				</div>

				<div class="flex items-center gap-2">
					<button
						@click="$refs.videoInput.click()"
						:disabled="isProcessing"
						class="text-xs font-medium px-3 py-1.5 border border-zinc-200 rounded-lg hover:bg-zinc-50 text-zinc-700 transition-colors disabled:opacity-50"
					>
						Change Video
					</button>
					<button
						@click="clearVideo()"
						:disabled="isProcessing"
						class="text-xs font-medium px-3 py-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors disabled:opacity-50"
					>
						Remove
					</button>
				</div>
			</div>

			<!-- Main Grid: Controls + Preview -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
				
				<!-- Left Column: Settings & Configuration -->
				<div class="lg:col-span-6 space-y-6">
					
					<!-- 1. Removal Mode Selection -->
					<div class="bg-white border border-zinc-200 rounded-2xl p-5 space-y-4 shadow-xs">
						<label class="block text-xs font-bold text-zinc-700 uppercase tracking-wider">1. Background Removal Method</label>
						
						<div class="grid grid-cols-2 gap-3">
							<!-- AI Removal Button -->
							<button
								type="button"
								@click="selectRemovalMode('ai')"
								:disabled="!hasWebGpu"
								:class="{
									'ring-2 ring-zinc-900 bg-zinc-900 text-white shadow-sm': removalMode === 'ai' && hasWebGpu,
									'border border-zinc-200 bg-zinc-50 text-zinc-800 hover:bg-zinc-100': removalMode !== 'ai' && hasWebGpu,
									'opacity-40 cursor-not-allowed border border-dashed border-zinc-300 bg-zinc-100 text-zinc-400': !hasWebGpu
								}"
								class="p-3.5 rounded-xl text-left transition-all relative flex flex-col justify-between"
							>
								<div>
									<div class="flex items-center justify-between">
										<p class="text-xs font-bold">🤖 AI Matting</p>
										<span x-show="hasWebGpu" class="text-[10px] font-mono px-1 rounded bg-emerald-500/20 text-emerald-300">WebGPU</span>
										<span x-show="!hasWebGpu" class="text-[9px] uppercase font-bold px-1 rounded bg-amber-200 text-amber-800">Locked</span>
									</div>
									<p class="text-[11px] opacity-75 mt-1 leading-tight">Separate person/subject automatically.</p>
								</div>
								<div class="mt-2 text-[10px] font-medium" :class="removalMode === 'ai' ? 'text-zinc-300' : 'text-zinc-500'">
									Wajib WebGPU
								</div>
							</button>

							<!-- Chroma Key Button -->
							<button
								type="button"
								@click="selectRemovalMode('chroma')"
								:class="removalMode === 'chroma' ? 'ring-2 ring-zinc-900 bg-zinc-900 text-white shadow-sm' : 'border border-zinc-200 bg-zinc-50 text-zinc-800 hover:bg-zinc-100'"
								class="p-3.5 rounded-xl text-left transition-all relative flex flex-col justify-between"
							>
								<div>
									<div class="flex items-center justify-between">
										<p class="text-xs font-bold">🟩 Green Screen</p>
										<span class="text-[10px] font-mono px-1 rounded bg-zinc-200 text-zinc-700">Universal</span>
									</div>
									<p class="text-[11px] opacity-75 mt-1 leading-tight">Chroma key for solid green / blue / custom color.</p>
								</div>
								<div class="mt-2 text-[10px] font-medium" :class="removalMode === 'chroma' ? 'text-zinc-300' : 'text-zinc-500'">
									No WebGPU needed
								</div>
							</button>
						</div>

						<!-- Chroma Key Controls (shown if chroma mode active) -->
						<div x-show="removalMode === 'chroma'" class="pt-3 border-t border-zinc-100 space-y-4">
							<div>
								<label class="block text-xs font-semibold text-zinc-700 mb-2">Key Color to Erase</label>
								<div class="flex flex-wrap items-center gap-2">
									<button
										type="button"
										@click="keyColor = '#00FF00'"
										class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 border"
										:class="keyColor.toLowerCase() === '#00ff00' ? 'border-zinc-900 bg-zinc-100 font-bold' : 'border-zinc-200 hover:bg-zinc-50'"
									>
										<span class="w-3 h-3 rounded-full bg-[#00FF00] border border-black/10"></span>
										Green Screen
									</button>
									<button
										type="button"
										@click="keyColor = '#0000FF'"
										class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 border"
										:class="keyColor.toLowerCase() === '#0000ff' ? 'border-zinc-900 bg-zinc-100 font-bold' : 'border-zinc-200 hover:bg-zinc-50'"
									>
										<span class="w-3 h-3 rounded-full bg-[#0000FF] border border-black/10"></span>
										Blue Screen
									</button>
									<div class="flex items-center gap-1.5 border border-zinc-200 rounded-lg px-2 py-1 bg-white">
										<input type="color" x-model="keyColor" class="w-5 h-5 rounded cursor-pointer border-0 p-0" />
										<span class="text-xs font-mono text-zinc-700 uppercase" x-text="keyColor"></span>
									</div>
								</div>
							</div>

							<!-- Sliders: Tolerance & Feathering -->
							<div class="grid grid-cols-2 gap-4">
								<div>
									<div class="flex justify-between text-xs font-medium text-zinc-600 mb-1">
										<span>Color Tolerance</span>
										<span class="font-mono" x-text="chromaTolerance + '%'"></span>
									</div>
									<input type="range" min="5" max="80" x-model.number="chromaTolerance" class="w-full accent-zinc-900 cursor-pointer" />
									<p class="text-[10px] text-zinc-400 mt-0.5">Higher = erases similar shades</p>
								</div>
								<div>
									<div class="flex justify-between text-xs font-medium text-zinc-600 mb-1">
										<span>Edge Softness</span>
										<span class="font-mono" x-text="chromaFeather + '%'"></span>
									</div>
									<input type="range" min="0" max="40" x-model.number="chromaFeather" class="w-full accent-zinc-900 cursor-pointer" />
									<p class="text-[10px] text-zinc-400 mt-0.5">Smooths boundary edges</p>
								</div>
							</div>
						</div>

						<!-- AI Mode Info (shown if AI mode active) -->
						<div x-show="removalMode === 'ai'" class="pt-3 border-t border-zinc-100 space-y-2">
							<div class="flex items-center justify-between text-xs">
								<span class="font-medium text-zinc-700">AI Model:</span>
								<span class="font-bold text-zinc-900 bg-zinc-100 px-2 py-0.5 rounded border border-zinc-200">MODNet WebGPU Matting</span>
							</div>
							<p class="text-[11px] text-zinc-500 leading-relaxed">
								Uses real-time portrait matting model via WebGPU hardware acceleration. Automatically identifies human subjects and generates smooth alpha mattes.
							</p>
						</div>
					</div>

					<!-- 2. New Replacement Background -->
					<div class="bg-white border border-zinc-200 rounded-2xl p-5 space-y-4 shadow-xs">
						<label class="block text-xs font-bold text-zinc-700 uppercase tracking-wider">2. New Background</label>

						<div class="grid grid-cols-3 gap-2">
							<button
								type="button"
								@click="bgType = 'transparent'"
								:class="bgType === 'transparent' ? 'border-zinc-900 bg-zinc-900 text-white shadow-xs' : 'border-zinc-200 bg-zinc-50 text-zinc-700 hover:bg-zinc-100'"
								class="p-2.5 border rounded-xl text-center text-xs font-semibold transition-all"
							>
								Transparent
								<span class="block text-[10px] opacity-70 mt-0.5">WebM Alpha</span>
							</button>

							<button
								type="button"
								@click="bgType = 'color'"
								:class="bgType === 'color' ? 'border-zinc-900 bg-zinc-900 text-white shadow-xs' : 'border-zinc-200 bg-zinc-50 text-zinc-700 hover:bg-zinc-100'"
								class="p-2.5 border rounded-xl text-center text-xs font-semibold transition-all"
							>
								Solid Color
								<span class="block text-[10px] opacity-70 mt-0.5">Hex / Palette</span>
							</button>

							<button
								type="button"
								@click="bgType = 'image'"
								:class="bgType === 'image' ? 'border-zinc-900 bg-zinc-900 text-white shadow-xs' : 'border-zinc-200 bg-zinc-50 text-zinc-700 hover:bg-zinc-100'"
								class="p-2.5 border rounded-xl text-center text-xs font-semibold transition-all"
							>
								Custom Image
								<span class="block text-[10px] opacity-70 mt-0.5">Upload Photo</span>
							</button>
						</div>

						<!-- Color Picker (if bgType === 'color') -->
						<div x-show="bgType === 'color'" class="pt-2 flex flex-wrap items-center gap-2">
							<template x-for="c in presetBgColors" :key="c">
								<button
									type="button"
									@click="solidColor = c"
									class="w-7 h-7 rounded-lg border flex items-center justify-center transition-all"
									:class="solidColor.toLowerCase() === c.toLowerCase() ? 'ring-2 ring-zinc-900 ring-offset-1 border-transparent' : 'border-zinc-300'"
									:style="`background-color: ${c}`"
								></button>
							</template>
							<div class="flex items-center gap-1.5 border border-zinc-300 rounded-lg px-2 py-1 bg-white ml-1">
								<input type="color" x-model="solidColor" class="w-5 h-5 rounded cursor-pointer border-0 p-0" />
								<span class="text-xs font-mono uppercase text-zinc-700" x-text="solidColor"></span>
							</div>
						</div>

						<!-- Custom Image Upload (if bgType === 'image') -->
						<div x-show="bgType === 'image'" class="pt-2 space-y-2">
							<div
								@click="$refs.bgImageInput.click()"
								class="border border-dashed border-zinc-300 hover:border-zinc-400 bg-zinc-50 hover:bg-zinc-100 rounded-xl p-3 text-center cursor-pointer transition-colors"
							>
								<template x-if="!bgImageSrc">
									<p class="text-xs text-zinc-600 font-medium">Click to upload background image (JPG, PNG, WebP)</p>
								</template>
								<template x-if="bgImageSrc">
									<div class="flex items-center justify-center gap-3">
										<img :src="bgImageSrc" class="w-10 h-10 object-cover rounded border border-zinc-200" alt="Background" />
										<span class="text-xs font-semibold text-zinc-700">Image Loaded (Click to change)</span>
									</div>
								</template>
							</div>
							<input type="file" accept="image/*" class="sr-only" x-ref="bgImageInput" @change="onBgImageUpload($event)" />
						</div>
					</div>

					<!-- 3. Performance & Output Resolution -->
					<div class="bg-white border border-zinc-200 rounded-2xl p-5 space-y-4 shadow-xs">
						<label class="block text-xs font-bold text-zinc-700 uppercase tracking-wider">3. Performance & Quality</label>
						
						<div class="grid grid-cols-2 gap-4">
							<!-- Resolution Scale -->
							<div>
								<label class="block text-xs font-medium text-zinc-600 mb-1">Resolution Scale</label>
								<select x-model="resolutionScale" class="w-full text-xs font-medium border border-zinc-300 rounded-lg px-2.5 py-2 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-500">
									<option value="0.5">50% Scale (Recommended ⚡)</option>
									<option value="0.75">75% Scale (Balanced)</option>
									<option value="1">100% Original Scale (High Quality)</option>
								</select>
								<p class="text-[10px] text-zinc-400 mt-1">
									Target: <strong class="font-mono text-zinc-600" x-text="targetWidth + ' × ' + targetHeight + ' px'"></strong>
								</p>
							</div>

							<!-- Frame Rate -->
							<div>
								<label class="block text-xs font-medium text-zinc-600 mb-1">Processing FPS</label>
								<select x-model="targetFps" class="w-full text-xs font-medium border border-zinc-300 rounded-lg px-2.5 py-2 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-500">
									<option value="15">15 FPS (Fastest processing)</option>
									<option value="24">24 FPS (Cinematic standard)</option>
									<option value="30">30 FPS (Full smoothness)</option>
								</select>
								<p class="text-[10px] text-zinc-400 mt-1">
									Estimated frames: <strong class="font-mono text-zinc-600" x-text="totalEstimatedFrames"></strong>
								</p>
							</div>
						</div>
					</div>

					<!-- 4. Action Button & Processing Progress -->
					<div class="space-y-3">
						<button
							x-show="!isProcessing"
							@click="startProcessing()"
							:disabled="isProcessing || (removalMode === 'ai' && !hasWebGpu)"
							class="w-full bg-zinc-900 hover:bg-zinc-800 text-white font-semibold py-3.5 px-6 rounded-2xl text-sm transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polygon points="5 3 19 12 5 21 5 3"/>
							</svg>
							<span>Start Video Background Removal</span>
						</button>

						<!-- Processing State Bar -->
						<div x-show="isProcessing" style="display:none;" class="p-4 bg-zinc-50 border border-zinc-200 rounded-2xl space-y-3">
							<div class="flex items-center justify-between text-xs">
								<div class="flex items-center gap-2">
									<svg class="animate-spin w-4 h-4 text-zinc-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
									<span class="font-bold text-zinc-900" x-text="progressText"></span>
								</div>
								<span class="font-mono font-bold text-zinc-800" x-text="Math.round(progressPercent) + '%'"></span>
							</div>

							<!-- Bar -->
							<div class="w-full bg-zinc-200 rounded-full h-2.5 overflow-hidden">
								<div class="bg-zinc-900 h-2.5 rounded-full transition-all duration-100" :style="`width: ${progressPercent}%`"></div>
							</div>

							<div class="flex items-center justify-between text-[11px] text-zinc-500">
								<span>Keep this browser tab open while processing.</span>
								<button @click="cancelProcessing()" class="text-red-600 font-semibold hover:underline">Cancel</button>
							</div>
						</div>
					</div>

				</div>

				<!-- Right Column: Video Players & Previews -->
				<div class="lg:col-span-6 space-y-6">
					
					<!-- Original Video Preview -->
					<div class="bg-white border border-zinc-200 rounded-2xl p-4 space-y-2 shadow-xs">
						<div class="flex items-center justify-between text-xs font-semibold text-zinc-700">
							<span>Original Input Video</span>
							<span class="font-mono text-zinc-500" x-text="formatDuration(duration)"></span>
						</div>
						<div class="bg-zinc-950 rounded-xl overflow-hidden flex items-center justify-center min-h-[220px] max-h-[300px]">
							<video
								x-ref="originalVideoPlayer"
								:src="videoSrc"
								class="max-h-[300px] w-full object-contain"
								controls
								playsinline
								muted
							></video>
						</div>
					</div>

					<!-- Result Video Output Preview -->
					<div class="bg-white border border-zinc-200 rounded-2xl p-4 space-y-3 shadow-xs">
						<div class="flex items-center justify-between">
							<span class="text-xs font-bold text-zinc-800 uppercase tracking-wider">Processed Result Preview</span>
							<template x-if="resultVideoSrc">
								<a
									:href="resultVideoSrc"
									:download="downloadFilename"
									class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors shadow-xs"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
									Download Video (.webm)
								</a>
							</template>
						</div>

						<!-- Checkered preview container for transparency -->
						<div
							class="rounded-xl overflow-hidden flex flex-col items-center justify-center min-h-[240px] max-h-[340px] border border-zinc-200 relative"
							style="background-image: linear-gradient(45deg, #e5e5e5 25%, transparent 25%), linear-gradient(-45deg, #e5e5e5 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e5e5e5 75%), linear-gradient(-45deg, transparent 75%, #e5e5e5 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px;"
						>
							<template x-if="!resultVideoSrc && !isProcessing">
								<div class="p-6 text-center text-xs text-zinc-500 bg-white/90 backdrop-blur-xs rounded-xl shadow-xs">
									Processed video with transparent or replaced background will appear here.
								</div>
							</template>

							<template x-if="isProcessing">
								<div class="p-6 text-center space-y-2 bg-white/90 backdrop-blur-xs rounded-xl shadow-xs">
									<svg class="animate-spin w-6 h-6 text-zinc-900 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
									<p class="text-xs font-semibold text-zinc-800" x-text="progressText"></p>
								</div>
							</template>

							<template x-if="resultVideoSrc">
								<video
									:src="resultVideoSrc"
									class="max-h-[340px] w-full object-contain"
									controls
									autoplay
									loop
									playsinline
								></video>
							</template>
						</div>

						<p class="text-[11px] text-zinc-400">
							Note: If exported as Transparent WebM (VP9 Alpha), some media players might display transparent areas as black. To composite onto video editors (e.g. CapCut, Premiere, DaVinci), import as WebM with alpha.
						</p>
					</div>

				</div>

			</div>
		</div>

		<!-- Hidden worker elements for video rendering and processing -->
		<video id="bgProcessVideo" preload="auto" muted playsinline style="display:none;"></video>
		<canvas id="bgSourceCanvas" style="display:none;"></canvas>
		<canvas id="bgOutputCanvas" style="display:none;"></canvas>
	</div>

	<script is:inline>
		document.addEventListener('alpine:init', () => {
			Alpine.data('removeVideoBgApp', () => ({
				// Hardware state
				isCheckingGpu: true,
				hasWebGpu: false,
				hasFp16: false,

				// Video state
				videoFile: null,
				videoSrc: '',
				duration: 0,
				videoWidth: 0,
				videoHeight: 0,
				isDragging: false,

				// Configuration
				removalMode: 'ai', // 'ai' | 'chroma'
				keyColor: '#00FF00',
				chromaTolerance: 30, // 0 - 100
				chromaFeather: 10,    // 0 - 100

				bgType: 'transparent', // 'transparent' | 'color' | 'image'
				solidColor: '#FFFFFF',
				presetBgColors: ['#FFFFFF', '#000000', '#EF4444', '#3B82F6', '#10B981', '#F59E0B'],
				bgImageSrc: '',
				bgImageElement: null,

				resolutionScale: '0.5',
				targetFps: '15',

				// Processing state
				isProcessing: false,
				isCancelled: false,
				progressPercent: 0,
				progressText: '',
				resultVideoSrc: '',

				get targetWidth() {
					return Math.round((this.videoWidth || 640) * parseFloat(this.resolutionScale));
				},
				get targetHeight() {
					return Math.round((this.videoHeight || 360) * parseFloat(this.resolutionScale));
				},
				get totalEstimatedFrames() {
					if (!this.duration) return 0;
					return Math.round(this.duration * parseInt(this.targetFps, 10));
				},
				get downloadFilename() {
					const base = (this.videoFile?.name || 'video').replace(/\.[^/.]+$/, '');
					return `${base}-bg-removed.webm`;
				},

				async init() {
					await this.probeWebGpu();
				},

				async probeWebGpu() {
					this.isCheckingGpu = true;
					try {
						if (typeof navigator !== 'undefined' && 'gpu' in navigator) {
							const adapter = await navigator.gpu.requestAdapter();
							if (adapter) {
								this.hasWebGpu = true;
								this.hasFp16 = adapter.features?.has('shader-f16') || false;
								this.removalMode = 'ai';
							} else {
								this.hasWebGpu = false;
								this.removalMode = 'chroma';
							}
						} else {
							this.hasWebGpu = false;
							this.removalMode = 'chroma';
						}
					} catch (e) {
						console.warn('WebGPU probe error:', e);
						this.hasWebGpu = false;
						this.removalMode = 'chroma';
					} finally {
						this.isCheckingGpu = false;
					}
				},

				selectRemovalMode(mode) {
					if (mode === 'ai' && !this.hasWebGpu) {
						alert('WebGPU is required for AI Video Removal. Please use an updated Chromium browser with hardware acceleration, or use Green Screen / Chroma Key mode.');
						return;
					}
					this.removalMode = mode;
				},

				onDrop(e) {
					this.isDragging = false;
					const file = e.dataTransfer.files[0];
					if (file && file.type.startsWith('video/')) {
						this.loadVideoFile(file);
					}
				},

				onFileChange(e) {
					const file = e.target.files[0];
					if (file) {
						this.loadVideoFile(file);
					}
				},

				loadVideoFile(file) {
					this.videoFile = file;
					if (this.videoSrc) URL.revokeObjectURL(this.videoSrc);
					if (this.resultVideoSrc) URL.revokeObjectURL(this.resultVideoSrc);
					this.resultVideoSrc = '';

					this.videoSrc = URL.createObjectURL(file);

					const tempVid = document.createElement('video');
					tempVid.preload = 'metadata';
					tempVid.src = this.videoSrc;
					tempVid.onloadedmetadata = () => {
						this.duration = tempVid.duration || 0;
						this.videoWidth = tempVid.videoWidth || 640;
						this.videoHeight = tempVid.videoHeight || 360;
					};
				},

				clearVideo() {
					if (this.isProcessing) return;
					if (this.videoSrc) URL.revokeObjectURL(this.videoSrc);
					if (this.resultVideoSrc) URL.revokeObjectURL(this.resultVideoSrc);
					this.videoFile = null;
					this.videoSrc = '';
					this.resultVideoSrc = '';
					this.duration = 0;
				},

				onBgImageUpload(e) {
					const file = e.target.files[0];
					if (!file) return;
					const reader = new FileReader();
					reader.onload = (event) => {
						this.bgImageSrc = event.target.result;
						const img = new Image();
						img.src = this.bgImageSrc;
						img.onload = () => {
							this.bgImageElement = img;
						};
					};
					reader.readAsDataURL(file);
				},

				formatDuration(sec) {
					if (!sec || isNaN(sec)) return '0:00';
					const m = Math.floor(sec / 60);
					const s = Math.floor(sec % 60);
					return `${m}:${s.toString().padStart(2, '0')}`;
				},

				formatSize(bytes) {
					if (!bytes) return '0 B';
					const k = 1024;
					const sizes = ['B', 'KB', 'MB', 'GB'];
					const i = Math.floor(Math.log(bytes) / Math.log(k));
					return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
				},

				seekVideo(video, time) {
					return new Promise((resolve) => {
						const onSeeked = () => {
							video.removeEventListener('seeked', onSeeked);
							resolve();
						};
						video.addEventListener('seeked', onSeeked);
						video.currentTime = Math.min(Math.max(0, time), video.duration - 0.05);
					});
				},

				// Parse hex color into RGB object
				hexToRgb(hex) {
					let clean = hex.replace('#', '');
					if (clean.length === 3) {
						clean = clean.split('').map(c => c + c).join('');
					}
					const num = parseInt(clean, 16);
					return {
						r: (num >> 16) & 255,
						g: (num >> 8) & 255,
						b: num & 255
					};
				},

				// Chroma Key processing on raw pixel data
				applyChromaKey(imageData, keyRgb, tolerance, feather) {
					const data = imageData.data;
					const len = data.length;
					const tol = (tolerance / 100) * 441.67; // max euclidean distance sqrt(255^2 * 3) ~ 441.67
					const featherDist = (feather / 100) * 100;

					for (let i = 0; i < len; i += 4) {
						const r = data[i];
						const g = data[i + 1];
						const b = data[i + 2];

						// Euclidean distance to key color
						const dist = Math.sqrt(
							(r - keyRgb.r) ** 2 +
							(g - keyRgb.g) ** 2 +
							(b - keyRgb.b) ** 2
						);

						if (dist < tol) {
							data[i + 3] = 0; // Completely transparent
						} else if (dist < tol + featherDist && featherDist > 0) {
							// Feather edge transition
							const alphaFactor = (dist - tol) / featherDist;
							data[i + 3] = Math.round(data[i + 3] * alphaFactor);
						}
					}
				},

				// Helper to convert canvas frame to Blob for AI input
				canvasToBlob(canvas, mime = 'image/jpeg', quality = 0.85) {
					return new Promise((resolve, reject) => {
						canvas.toBlob((b) => {
							if (b) resolve(b);
							else reject(new Error('Failed to capture canvas frame blob'));
						}, mime, quality);
					});
				},

				// Main video processing routine
				async startProcessing() {
					if (!this.videoFile || this.isProcessing) return;
					if (this.removalMode === 'ai' && !this.hasWebGpu) {
						alert('WebGPU is mandatory for AI Video Removal. Please use Chroma Key mode instead.');
						return;
					}

					this.isProcessing = true;
					this.isCancelled = false;
					this.progressPercent = 0;
					this.progressText = 'Initializing video pipeline...';

					if (this.resultVideoSrc) {
						URL.revokeObjectURL(this.resultVideoSrc);
						this.resultVideoSrc = '';
					}

					try {
						const processVideo = document.getElementById('bgProcessVideo');
						processVideo.src = this.videoSrc;
						await new Promise((res) => {
							processVideo.onloadeddata = res;
						});

						const fps = parseInt(this.targetFps, 10);
						const frameInterval = 1 / fps;
						const totalFrames = Math.max(1, Math.floor(this.duration * fps));

						const width = this.targetWidth;
						const height = this.targetHeight;

						const srcCanvas = document.getElementById('bgSourceCanvas');
						const outCanvas = document.getElementById('bgOutputCanvas');
						srcCanvas.width = width;
						srcCanvas.height = height;
						outCanvas.width = width;
						outCanvas.height = height;

						const srcCtx = srcCanvas.getContext('2d', { willReadFrequently: true });
						const outCtx = outCanvas.getContext('2d', { willReadFrequently: true });

						// Pre-load AI library & model if AI mode
						let aiRemoveBackground = null;
						if (this.removalMode === 'ai') {
							this.progressText = 'Loading AI model with WebGPU...';
							const { removeBackground, preload } = await import('https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.7.0/+esm');
							aiRemoveBackground = removeBackground;
							try {
								await preload({
									device: 'gpu',
									model: 'isnet_quint8'
								});
							} catch (preloadErr) {
								console.warn('Preload notice:', preloadErr);
							}
						}

						// Setup MediaRecorder from outCanvas stream
						const stream = outCanvas.captureStream(fps);
						const mimeType = MediaRecorder.isTypeSupported('video/webm; codecs=vp9')
							? 'video/webm; codecs=vp9'
							: (MediaRecorder.isTypeSupported('video/webm; codecs=vp8')
								? 'video/webm; codecs=vp8'
								: 'video/webm');

						const recordedChunks = [];
						const mediaRecorder = new MediaRecorder(stream, {
							mimeType,
							videoBitsPerSecond: 2500000
						});

						mediaRecorder.ondataavailable = (e) => {
							if (e.data && e.data.size > 0) recordedChunks.push(e.data);
						};

						mediaRecorder.start();

						const keyRgb = this.hexToRgb(this.keyColor);
						const solidRgb = this.hexToRgb(this.solidColor);

						// Process Frame by Frame Loop
						for (let i = 0; i < totalFrames; i++) {
							if (this.isCancelled) {
								mediaRecorder.stop();
								break;
							}

							const currentTime = i * frameInterval;
							this.progressPercent = Math.min(99, Math.round(((i + 1) / totalFrames) * 100));
							this.progressText = `Processing frame ${i + 1}/${totalFrames} (${this.removalMode.toUpperCase()} Mode)...`;

							// Seek video to exact frame
							await this.seekVideo(processVideo, currentTime);

							// Draw video frame to source canvas
							srcCtx.clearRect(0, 0, width, height);
							srcCtx.drawImage(processVideo, 0, 0, width, height);

							// Clear output canvas
							outCtx.clearRect(0, 0, width, height);

							// Draw new background if not transparent
							if (this.bgType === 'color') {
								outCtx.fillStyle = this.solidColor;
								outCtx.fillRect(0, 0, width, height);
							} else if (this.bgType === 'image' && this.bgImageElement) {
								outCtx.drawImage(this.bgImageElement, 0, 0, width, height);
							}

							if (this.removalMode === 'chroma') {
								// Fast client-side Chroma Key
								const imgData = srcCtx.getImageData(0, 0, width, height);
								this.applyChromaKey(imgData, keyRgb, this.chromaTolerance, this.chromaFeather);
								
								// Put masked foreground onto canvas
								srcCtx.putImageData(imgData, 0, 0);
								outCtx.drawImage(srcCanvas, 0, 0);
							} else if (this.removalMode === 'ai' && aiRemoveBackground) {
								// Convert source canvas frame to JPEG Blob (fast & compatible with imgly decoder)
								const frameBlob = await this.canvasToBlob(srcCanvas, 'image/jpeg', 0.85);

								// WebGPU AI Matting
								const blob = await aiRemoveBackground(frameBlob, {
									device: 'gpu',
									model: 'isnet_quint8',
									output: { format: 'image/png' }
								});
								const imgBitmap = await createImageBitmap(blob);
								outCtx.drawImage(imgBitmap, 0, 0, width, height);
								imgBitmap.close(); // Clean up GPU memory immediately
							}

							// Trigger canvas stream frame capture if available
							const track = stream.getVideoTracks()[0];
							if (track && typeof track.requestFrame === 'function') {
								track.requestFrame();
							}

							// Yield to allow browser UI & MediaRecorder to capture frame cleanly
							await new Promise((r) => setTimeout(r, Math.max(15, Math.floor(1000 / fps))));
						}

						if (!this.isCancelled) {
							this.progressText = 'Finalizing video encoding...';
							await new Promise((resolve) => {
								mediaRecorder.onstop = resolve;
								mediaRecorder.stop();
							});

							const finalBlob = new Blob(recordedChunks, { type: mimeType });
							this.resultVideoSrc = URL.createObjectURL(finalBlob);
							this.progressPercent = 100;
							this.progressText = 'Finished!';
						}

					} catch (err) {
						console.error('Error during video processing:', err);
						alert('Failed to process video: ' + (err.message || err));
					} finally {
						this.isProcessing = false;
						this.progressText = '';
					}
				},

				cancelProcessing() {
					this.isCancelled = true;
					this.isProcessing = false;
					this.progressText = 'Cancelled';
				}
			}));
		});
	</script>
</Layout>

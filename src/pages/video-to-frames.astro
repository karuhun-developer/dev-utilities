---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Video to Frames Extractor"
	description="Extract high-quality image frames and snapshots from video files. Convert video to WEBP, PNG, JPG, or BMP sequence — free, fast, and 100% locally in your browser."
	keywords="video to frames, extract video frames, video to image sequence, video snapshot, video screenshot, convert mp4 to webp, convert video to png, client side video processing"
>
	<div class="max-w-6xl" x-data="videoToFramesApp()" x-init="init()">
		<div class="flex flex-wrap items-center justify-between gap-4 mb-2">
			<h1 class="text-2xl font-bold text-zinc-900">Video to Frames Extractor</h1>
			<span class="text-xs font-semibold px-2.5 py-1 bg-zinc-100 text-zinc-700 rounded-full border border-zinc-200 flex items-center gap-1.5">
				<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
				100% Client-Side & Private
			</span>
		</div>
		<p class="text-zinc-600 mb-8">
			Extract high quality image sequences, snapshots, or specific timestamps from any video file. Export to WEBP, PNG, JPG, or BMP and download individually or as a ZIP archive.
		</p>

		<!-- Upload Zone (shown when no video loaded) -->
		<div
			x-show="!videoSrc"
			class="relative flex flex-col items-center justify-center border-2 border-dashed rounded-2xl px-8 py-12 text-center transition-all cursor-pointer mb-6"
			:class="isDragging ? 'border-zinc-600 bg-zinc-100' : 'border-zinc-300 bg-zinc-50 hover:bg-zinc-100 hover:border-zinc-400'"
			@dragover.prevent="isDragging = true"
			@dragleave.prevent="isDragging = false"
			@drop.prevent="onDrop($event)"
			@click="$refs.videoInput.click()"
		>
			<div class="w-14 h-14 rounded-2xl bg-zinc-200/60 flex items-center justify-center text-zinc-600 mb-4 shadow-sm">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
				</svg>
			</div>
			<p class="text-base font-semibold text-zinc-800">Drop your video here or <span class="text-zinc-900 underline underline-offset-2">browse file</span></p>
			<p class="text-xs text-zinc-400 mt-1">MP4 · WEBM · MOV · MKV · AVI · OGG · Fast local processing</p>
			<input
				type="file"
				accept="video/*"
				class="sr-only"
				x-ref="videoInput"
				@change="onFileChange($event)"
			/>
		</div>

		<!-- Main Workspace (shown when video is loaded) -->
		<div x-show="videoSrc" style="display: none;" class="space-y-8">
			
			<!-- Video Info Bar -->
			<div class="bg-white border border-zinc-200 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4 shadow-sm">
				<div class="flex items-center gap-3 min-w-0">
					<div class="w-10 h-10 rounded-xl bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 flex-shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
					</div>
					<div class="min-w-0">
						<p class="text-sm font-semibold text-zinc-900 truncate" x-text="videoFile?.name || 'video'"></p>
						<div class="flex items-center gap-2 text-xs text-zinc-500 mt-0.5">
							<span x-text="formatDuration(duration)"></span>
							<span>·</span>
							<span x-text="videoWidth + ' × ' + videoHeight + ' px'"></span>
							<span>·</span>
							<span x-text="formatSize(videoFile?.size || 0)"></span>
						</div>
					</div>
				</div>

				<div class="flex items-center gap-2">
					<button
						@click="$refs.videoInput.click()"
						class="text-xs font-medium px-3 py-1.5 border border-zinc-200 rounded-lg hover:bg-zinc-50 text-zinc-700 transition-colors"
					>
						Change Video
					</button>
					<button
						@click="clearVideo()"
						class="text-xs font-medium px-3 py-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors"
					>
						Remove
					</button>
				</div>
			</div>

			<!-- Grid: Video Player + Controls -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
				
				<!-- Left Column: Video Preview & Manual Snapshot -->
				<div class="lg:col-span-5 space-y-4">
					<div class="bg-zinc-900 rounded-2xl overflow-hidden border border-zinc-800 shadow-md relative group">
						<video
							x-ref="mainVideo"
							:src="videoSrc"
							class="w-full max-h-[380px] object-contain bg-black"
							controls
							playsinline
							@timeupdate="onMainVideoTimeUpdate()"
						></video>
					</div>

					<!-- Single Snapshot Card -->
					<div class="bg-zinc-50 border border-zinc-200 rounded-2xl p-4 space-y-3">
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-xs font-bold text-zinc-800 uppercase tracking-wider">Instant Snapshot</h3>
								<p class="text-[11px] text-zinc-500">Capture exact frame at current video playback position</p>
							</div>
							<span class="text-xs font-mono font-bold text-zinc-700 bg-white border border-zinc-200 px-2 py-0.5 rounded" x-text="formatDuration(currentVideoTime, true)"></span>
						</div>
						<button
							@click="captureCurrentFrame()"
							:disabled="isExtracting"
							class="w-full bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold py-2.5 px-4 rounded-xl transition-all flex items-center justify-center gap-2 shadow-sm disabled:opacity-50"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>
							</svg>
							Capture Current Frame
						</button>
					</div>
				</div>

				<!-- Right Column: Batch Extraction Settings -->
				<div class="lg:col-span-7 space-y-5">
					<div class="bg-white border border-zinc-200 rounded-2xl p-6 space-y-6 shadow-sm">
						
						<!-- Section 1: Extraction Mode -->
						<div>
							<label class="block text-xs font-bold text-zinc-600 uppercase tracking-wider mb-3">1. Extraction Mode</label>
							<div class="grid grid-cols-3 gap-2">
								<button
									@click="mode = 'interval'"
									:class="mode === 'interval' ? 'bg-zinc-900 text-white border-zinc-900 shadow-sm' : 'bg-zinc-50 text-zinc-700 border-zinc-200 hover:bg-zinc-100'"
									class="p-2.5 border rounded-xl text-left transition-all"
								>
									<p class="text-xs font-bold">Time Interval</p>
									<p class="text-[10px] opacity-70 mt-0.5">Every X seconds</p>
								</button>
								<button
									@click="mode = 'total'"
									:class="mode === 'total' ? 'bg-zinc-900 text-white border-zinc-900 shadow-sm' : 'bg-zinc-50 text-zinc-700 border-zinc-200 hover:bg-zinc-100'"
									class="p-2.5 border rounded-xl text-left transition-all"
								>
									<p class="text-xs font-bold">Total Frames</p>
									<p class="text-[10px] opacity-70 mt-0.5">Evenly distributed</p>
								</button>
								<button
									@click="mode = 'fps'"
									:class="mode === 'fps' ? 'bg-zinc-900 text-white border-zinc-900 shadow-sm' : 'bg-zinc-50 text-zinc-700 border-zinc-200 hover:bg-zinc-100'"
									class="p-2.5 border rounded-xl text-left transition-all"
								>
									<p class="text-xs font-bold">Frame Rate (FPS)</p>
									<p class="text-[10px] opacity-70 mt-0.5">Frames per second</p>
								</button>
							</div>

							<!-- Mode specific inputs -->
							<div class="mt-4 p-3.5 bg-zinc-50 border border-zinc-200 rounded-xl">
								
								<!-- Interval Mode -->
								<div x-show="mode === 'interval'" class="space-y-3">
									<div class="flex items-center justify-between">
										<label class="text-xs font-medium text-zinc-700">Interval between frames:</label>
										<span class="text-xs font-bold text-zinc-900 font-mono" x-text="intervalSeconds + ' s'"></span>
									</div>
									<div class="flex items-center gap-2">
										<input
											type="range"
											x-model.number="intervalSeconds"
											min="0.1"
											:max="Math.max(duration, 5)"
											step="0.1"
											class="flex-1 accent-zinc-900"
										/>
									</div>
									<div class="flex flex-wrap gap-1.5">
										<template x-for="preset in [0.5, 1, 2, 5, 10]" :key="preset">
											<button
												@click="intervalSeconds = preset"
												:class="intervalSeconds === preset ? 'bg-zinc-900 text-white' : 'bg-white text-zinc-600 border border-zinc-200 hover:bg-zinc-100'"
												class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors"
												x-text="preset + 's'"
											></button>
										</template>
									</div>
								</div>

								<!-- Total Frames Mode -->
								<div x-show="mode === 'total'" class="space-y-3" style="display:none;">
									<div class="flex items-center justify-between">
										<label class="text-xs font-medium text-zinc-700">Number of frames to extract:</label>
										<span class="text-xs font-bold text-zinc-900 font-mono" x-text="totalFramesCount + ' frames'"></span>
									</div>
									<input
										type="range"
										x-model.number="totalFramesCount"
										min="2"
										max="100"
										step="1"
										class="w-full accent-zinc-900"
									/>
									<div class="flex flex-wrap gap-1.5">
										<template x-for="preset in [5, 10, 20, 30, 50]" :key="preset">
											<button
												@click="totalFramesCount = preset"
												:class="totalFramesCount === preset ? 'bg-zinc-900 text-white' : 'bg-white text-zinc-600 border border-zinc-200 hover:bg-zinc-100'"
												class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors"
												x-text="preset + ' frames'"
											></button>
										</template>
									</div>
								</div>

								<!-- FPS Mode -->
								<div x-show="mode === 'fps'" class="space-y-3" style="display:none;">
									<div class="flex items-center justify-between">
										<label class="text-xs font-medium text-zinc-700">Frame extraction rate:</label>
										<span class="text-xs font-bold text-zinc-900 font-mono" x-text="fpsRate + ' FPS'"></span>
									</div>
									<div class="flex flex-wrap gap-2">
										<template x-for="fps in [0.5, 1, 2, 5, 10, 24]" :key="fps">
											<button
												@click="fpsRate = fps"
												:class="fpsRate === fps ? 'bg-zinc-900 text-white' : 'bg-white text-zinc-600 border border-zinc-200 hover:bg-zinc-100'"
												class="flex-1 py-1.5 rounded-lg text-xs font-semibold transition-colors text-center"
												x-text="fps + ' fps'"
											></button>
										</template>
									</div>
								</div>

							</div>
						</div>

						<!-- Section 2: Time Range (Optional) -->
						<div class="pt-2 border-t border-zinc-100">
							<div class="flex items-center justify-between mb-2">
								<label class="text-xs font-bold text-zinc-600 uppercase tracking-wider">2. Video Range</label>
								<label class="flex items-center gap-1.5 text-xs text-zinc-600 cursor-pointer">
									<input type="checkbox" x-model="useFullVideo" class="rounded text-zinc-900 focus:ring-zinc-900 border-zinc-300">
									<span>Entire Video (0:00 - <span x-text="formatDuration(duration)"></span>)</span>
								</label>
							</div>

							<div x-show="!useFullVideo" class="grid grid-cols-2 gap-3 p-3 bg-zinc-50 border border-zinc-200 rounded-xl">
								<div>
									<label class="block text-[11px] font-semibold text-zinc-500 mb-1">Start Time (seconds)</label>
									<input
										type="number"
										x-model.number="startTime"
										min="0"
										:max="endTime"
										step="0.1"
										class="w-full px-2.5 py-1.5 text-xs font-mono border border-zinc-300 rounded-lg bg-white focus:outline-none focus:ring-1 focus:ring-zinc-500"
									/>
								</div>
								<div>
									<label class="block text-[11px] font-semibold text-zinc-500 mb-1">End Time (seconds)</label>
									<input
										type="number"
										x-model.number="endTime"
										:min="startTime"
										:max="duration"
										step="0.1"
										class="w-full px-2.5 py-1.5 text-xs font-mono border border-zinc-300 rounded-lg bg-white focus:outline-none focus:ring-1 focus:ring-zinc-500"
									/>
								</div>
							</div>
						</div>

						<!-- Section 3: Output Format & Quality -->
						<div class="pt-2 border-t border-zinc-100 space-y-4">
							<label class="block text-xs font-bold text-zinc-600 uppercase tracking-wider">3. Output Format & Settings</label>
							
							<div class="grid grid-cols-4 gap-2">
								<template x-for="fmt in formats" :key="fmt.value">
									<button
										@click="targetFormat = fmt.value"
										:class="targetFormat === fmt.value
											? 'bg-zinc-900 text-white border-zinc-900 shadow-sm'
											: 'bg-zinc-50 text-zinc-700 border-zinc-200 hover:bg-zinc-100'"
										class="flex flex-col items-center justify-center p-2.5 border rounded-xl text-xs font-bold tracking-wide transition-all"
									>
										<span x-text="fmt.label"></span>
										<span class="text-[9px] font-normal opacity-70" x-text="fmt.note"></span>
									</button>
								</template>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
								<!-- Quality slider for lossy formats -->
								<div x-show="isLossy" class="bg-zinc-50 p-3 rounded-xl border border-zinc-200">
									<div class="flex justify-between mb-1.5">
										<label class="text-xs font-semibold text-zinc-600">Image Quality</label>
										<span class="text-xs font-mono font-bold text-zinc-900" x-text="Math.round(quality * 100) + '%'"></span>
									</div>
									<input type="range" x-model.number="quality" min="0.1" max="1.0" step="0.05" class="w-full accent-zinc-900" />
									<div class="flex justify-between text-[10px] text-zinc-400 mt-1">
										<span>Smaller size</span><span>High quality</span>
									</div>
								</div>

								<!-- Scaling -->
								<div class="bg-zinc-50 p-3 rounded-xl border border-zinc-200">
									<label class="block text-xs font-semibold text-zinc-600 mb-1.5">Resolution Scale</label>
									<select x-model="scalePreset" class="w-full text-xs font-medium border border-zinc-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-500">
										<option value="1">Original (100%) - <span x-text="videoWidth + '×' + videoHeight"></span></option>
										<option value="0.75">75% Resolution</option>
										<option value="0.5">50% Resolution (Faster / Smaller)</option>
										<option value="0.25">25% Thumbnail Size</option>
									</select>
									<p class="text-[10px] text-zinc-400 mt-1">
										Output: <span class="font-mono text-zinc-600 font-semibold" x-text="Math.round(videoWidth * parseFloat(scalePreset)) + ' × ' + Math.round(videoHeight * parseFloat(scalePreset)) + ' px'"></span>
									</p>
								</div>
							</div>
						</div>

						<!-- Action Button & Estimate -->
						<div class="pt-4 border-t border-zinc-100">
							<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
								<span class="text-xs font-medium text-zinc-500">
									Estimated output: <strong class="text-zinc-800 font-bold" x-text="estimatedFramesCount + ' frames'"></strong>
								</span>
								<span x-show="estimatedFramesCount > 150" class="text-xs text-amber-600 font-medium">
									⚠️ Large number of frames may take longer.
								</span>
							</div>

							<!-- Normal state button -->
							<button
								x-show="!isExtracting"
								@click="startExtraction()"
								:disabled="isExtracting || duration <= 0"
								class="w-full bg-zinc-900 hover:bg-zinc-800 text-white font-semibold py-3 px-6 rounded-xl text-sm transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg disabled:opacity-50"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/>
								</svg>
								<span>Start Frame Extraction</span>
							</button>

							<!-- Progress state -->
							<div x-show="isExtracting" style="display:none;" class="space-y-3 p-4 bg-zinc-50 border border-zinc-200 rounded-xl">
								<div class="flex items-center justify-between text-xs">
									<div class="flex items-center gap-2">
										<svg class="animate-spin w-4 h-4 text-zinc-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
										<span class="font-semibold text-zinc-800" x-text="progressText"></span>
									</div>
									<span class="font-mono font-bold text-zinc-700" x-text="Math.round(progressPercent) + '%'"></span>
								</div>
								<!-- Progress Bar -->
								<div class="w-full bg-zinc-200 rounded-full h-2 overflow-hidden">
									<div class="bg-zinc-900 h-2 rounded-full transition-all duration-150" :style="`width: ${progressPercent}%`"></div>
								</div>
								<button
									@click="cancelExtraction()"
									class="text-xs font-semibold text-red-600 hover:text-red-700 block text-center w-full py-1 hover:underline"
								>
									Cancel Extraction
								</button>
							</div>
						</div>

					</div>
				</div>

			</div>

			<!-- Extracted Frames Gallery Section -->
			<div x-show="frames.length > 0" style="display: none;" class="space-y-6 pt-4 border-t border-zinc-200">
				
				<!-- Gallery Header & Actions -->
				<div class="bg-white border border-zinc-200 rounded-2xl p-5 flex flex-wrap items-center justify-between gap-4 shadow-sm">
					<div>
						<h2 class="text-base font-bold text-zinc-900 flex items-center gap-2">
							<span>Extracted Frames</span>
							<span class="text-xs font-semibold bg-zinc-100 text-zinc-800 border border-zinc-200 px-2.5 py-0.5 rounded-full" x-text="frames.length + ' frames'"></span>
						</h2>
						<p class="text-xs text-zinc-500 mt-0.5">
							Format: <strong class="uppercase text-zinc-700" x-text="targetFormat"></strong> · Total size: <strong class="text-zinc-700" x-text="formatSize(totalFramesSize)"></strong>
						</p>
					</div>

					<div class="flex flex-wrap items-center gap-2.5">
						<!-- Download All as ZIP -->
						<button
							@click="downloadZip()"
							:disabled="isZipping"
							class="bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold px-4 py-2 rounded-xl transition-all flex items-center gap-2 shadow-sm disabled:opacity-50"
						>
							<template x-if="!isZipping">
								<span class="flex items-center gap-1.5">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
									Download All (ZIP)
								</span>
							</template>
							<template x-if="isZipping">
								<span class="flex items-center gap-1.5">
									<svg class="animate-spin w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
									<span x-text="zipProgressText"></span>
								</span>
							</template>
						</button>

						<!-- Download Separately -->
						<button
							@click="downloadAllSequential()"
							class="border border-zinc-300 hover:bg-zinc-50 text-zinc-700 text-xs font-semibold px-3 py-2 rounded-xl transition-all flex items-center gap-1.5"
							title="Download images individually"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 17 12 21 16 17"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"/></svg>
							Download All (Files)
						</button>

						<!-- Clear All -->
						<button
							@click="clearFrames()"
							class="text-xs text-zinc-400 hover:text-red-500 transition-colors px-2 py-1"

				<!-- Frame Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3.5">
					<template x-for="(frame, index) in frames" :key="frame.id">
						<div class="bg-white border border-zinc-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group flex flex-col">
							
							<!-- Thumbnail container with checkerboard background for transparent formats -->
							<div
								class="relative aspect-video bg-zinc-100 flex items-center justify-center overflow-hidden cursor-pointer"
								style="background-image: linear-gradient(45deg, #e4e4e7 25%, transparent 25%), linear-gradient(-45deg, #e4e4e7 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e4e4e7 75%), linear-gradient(-45deg, transparent 75%, #e4e4e7 75%); background-size: 8px 8px; background-position: 0 0, 0 4px, 4px -4px, -4px 0px;"
								@click="openModal(index)"
							>
								<img :src="frame.dataUrl" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-200" :alt="frame.filename" loading="lazy" />
								
								<!-- Timestamp badge -->
								<div class="absolute top-1.5 left-1.5 bg-black/70 backdrop-blur-xs text-white text-[10px] font-mono px-1.5 py-0.5 rounded shadow">
									<span x-text="formatDuration(frame.timestamp, true)"></span>
								</div>

								<!-- Frame # badge -->
								<div class="absolute top-1.5 right-1.5 bg-white/90 backdrop-blur-xs text-zinc-800 text-[10px] font-bold px-1.5 py-0.5 rounded shadow">
									#<span x-text="index + 1"></span>
								</div>

								<!-- Hover Overlay with Zoom Icon -->
								<div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
									<span class="p-1.5 bg-white/90 rounded-full text-zinc-900 shadow">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
									</span>
								</div>
							</div>

							<!-- Card Footer / Actions -->
							<div class="p-2.5 flex-1 flex flex-col justify-between bg-white border-t border-zinc-100">
								<div class="flex items-center justify-between text-[11px] text-zinc-500 mb-2">
									<span class="font-mono text-zinc-400" x-text="frame.width + '×' + frame.height"></span>
									<span class="font-medium" x-text="formatSize(frame.size)"></span>
								</div>

								<div class="flex items-center gap-1">
									<!-- Download -->
									<button
										@click.stop="downloadSingle(frame)"
										class="flex-1 bg-zinc-900 hover:bg-zinc-800 text-white text-[11px] font-semibold py-1 px-2 rounded-lg transition-colors flex items-center justify-center gap-1"
										title="Download image"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
										Save
									</button>

									<!-- Copy to Clipboard -->
									<button
										@click.stop="copyToClipboard(frame)"
										class="p-1 text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors border border-zinc-200"
										title="Copy frame to clipboard"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
									</button>

									<!-- Delete -->
									<button
										@click.stop="removeFrame(index)"
										class="p-1 text-zinc-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"
										title="Remove frame"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
									</button>
								</div>
							</div>

						</div>
					</template>
				</div>
			</div>

		</div>

		<!-- Full Size Image Lightbox Modal -->
		<div
			x-show="modalOpen"
			style="display: none;"
			class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
			@keydown.window.escape="modalOpen = false"
			@keydown.window.arrow-left="prevModalImage()"
			@keydown.window.arrow-right="nextModalImage()"
		>
			<div class="relative bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col shadow-2xl" @click.outside="modalOpen = false">
				
				<!-- Modal Header -->
				<div class="px-5 py-3 border-b border-zinc-200 flex items-center justify-between bg-zinc-50">
					<div class="flex items-center gap-2">
						<span class="text-sm font-bold text-zinc-800" x-text="`Frame #${activeModalIndex + 1} of ${frames.length}`"></span>
						<span class="text-xs font-mono bg-zinc-200 text-zinc-700 px-2 py-0.5 rounded" x-text="formatDuration(activeModalFrame?.timestamp || 0, true)"></span>
						<span class="text-xs text-zinc-500" x-text="`${activeModalFrame?.width}×${activeModalFrame?.height} px · ${formatSize(activeModalFrame?.size || 0)}`"></span>
					</div>
					<button @click="modalOpen = false" class="p-1 text-zinc-400 hover:text-zinc-700 rounded-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
					</button>
				</div>

				<!-- Modal Body / Image -->
				<div class="flex-1 overflow-auto p-4 flex items-center justify-center bg-zinc-950 min-h-[300px]">
					<template x-if="activeModalFrame">
						<img :src="activeModalFrame.dataUrl" class="max-w-full max-h-[65vh] object-contain shadow-lg" :alt="activeModalFrame.filename" />
					</template>
				</div>

				<!-- Modal Footer -->
				<div class="px-5 py-3 border-t border-zinc-200 flex items-center justify-between bg-white">
					<div class="flex items-center gap-2">
						<button
							@click="prevModalImage()"
							:disabled="activeModalIndex <= 0"
							class="px-3 py-1.5 text-xs font-semibold border border-zinc-200 rounded-lg hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed flex items-center gap-1"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
							Previous
						</button>
						<button
							@click="nextModalImage()"
							:disabled="activeModalIndex >= frames.length - 1"
							class="px-3 py-1.5 text-xs font-semibold border border-zinc-200 rounded-lg hover:bg-zinc-50 disabled:opacity-30 disabled:cursor-not-allowed flex items-center gap-1"
						>
							Next
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
						</button>
					</div>

					<div class="flex items-center gap-2">
						<button
							@click="copyToClipboard(activeModalFrame)"
							class="px-3 py-1.5 text-xs font-semibold border border-zinc-200 hover:bg-zinc-50 text-zinc-700 rounded-lg flex items-center gap-1.5"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
							Copy
						</button>
						<button
							@click="downloadSingle(activeModalFrame)"
							class="bg-zinc-900 hover:bg-zinc-800 text-white px-4 py-1.5 text-xs font-semibold rounded-lg flex items-center gap-1.5"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
							Download
						</button>
					</div>
				</div>

			</div>
		</div>

		<!-- Toast Notification -->
		<div
			x-show="toastMessage"
			x-transition
			style="display: none;"
			class="fixed bottom-6 right-6 z-50 bg-zinc-900 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2 border border-zinc-700"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
			<span x-text="toastMessage"></span>
		</div>

		<!-- Hidden Elements for Background Extraction -->
		<video id="hiddenExtractVideo" preload="auto" muted playsinline style="display:none;"></video>
		<canvas id="extractCanvas" style="display:none;"></canvas>
	</div>

	<script is:inline>
	window.__jszipLoaded = new Promise((resolve, reject) => {
		const s = document.createElement('script');
		s.src = 'https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js';
		s.onload = resolve;
		s.onerror = reject;
		document.head.appendChild(s);
	});

	document.addEventListener('alpine:init', () => {
		Alpine.data('videoToFramesApp', () => ({
			videoFile: null,
			videoSrc: '',
			duration: 0,
			videoWidth: 0,
			videoHeight: 0,
			currentVideoTime: 0,
			isDragging: false,

			// Extraction Settings
			mode: 'interval', // interval | total | fps
			intervalSeconds: 1,
			totalFramesCount: 10,
			fpsRate: 1,

			useFullVideo: true,
			startTime: 0,
			endTime: 0,

			// Format settings
			targetFormat: 'webp',
			quality: 0.92,
			scalePreset: '1',

			formats: [
				{ value: 'webp', label: 'WEBP', note: 'Recommended' },
				{ value: 'png',  label: 'PNG',  note: 'Lossless' },
				{ value: 'jpg',  label: 'JPG',  note: 'Compact' },
				{ value: 'bmp',  label: 'BMP',  note: 'Raw' },
			],

			// Processing state
			isExtracting: false,
			isCancelled: false,
			progressPercent: 0,
			progressText: '',

			// Extracted frames
			frames: [],
			isZipping: false,
			zipProgressText: '',

			// Lightbox modal state
			modalOpen: false,
			activeModalIndex: 0,

			// Toast message
			toastMessage: '',
			toastTimer: null,

			get isLossy() {
				return ['webp', 'jpg'].includes(this.targetFormat);
			},

			get totalFramesSize() {
				return this.frames.reduce((acc, f) => acc + (f.size || 0), 0);
			},

			get activeModalFrame() {
				return this.frames[this.activeModalIndex] || null;
			},

			get effectiveRange() {
				const start = this.useFullVideo ? 0 : Math.max(0, this.startTime);
				const end = this.useFullVideo ? this.duration : Math.min(this.duration, Math.max(start + 0.01, this.endTime));
				return { start, end, range: Math.max(0.01, end - start) };
			},

			get estimatedFramesCount() {
				if (this.duration <= 0) return 0;
				const { range } = this.effectiveRange;
				if (this.mode === 'interval') {
					const step = Math.max(0.05, this.intervalSeconds);
					return Math.max(1, Math.floor(range / step) + 1);
				}
				if (this.mode === 'total') {
					return Math.max(1, this.totalFramesCount);
				}
				if (this.mode === 'fps') {
					const fps = Math.max(0.1, this.fpsRate);
					return Math.max(1, Math.floor(range * fps) + 1);
				}
				return 0;
			},

			init() {
				this.$watch('duration', (val) => {
					if (val > 0) {
						this.endTime = parseFloat(val.toFixed(2));
					}
				});
			},

			showToast(msg) {
				this.toastMessage = msg;
				clearTimeout(this.toastTimer);
				this.toastTimer = setTimeout(() => {
					this.toastMessage = '';
				}, 2500);
			},

			onFileChange(e) {
				const file = e.target.files[0];
				if (file) this.loadVideo(file);
				e.target.value = '';
			},

			onDrop(e) {
				this.isDragging = false;
				const file = [...e.dataTransfer.files].find(f => f.type.startsWith('video/'));
				if (file) this.loadVideo(file);
			},

			loadVideo(file) {
				if (this.videoSrc) {
					URL.revokeObjectURL(this.videoSrc);
				}
				this.videoFile = file;
				this.videoSrc = URL.createObjectURL(file);
				this.frames = [];
				this.currentVideoTime = 0;

				const hiddenVid = document.getElementById('hiddenExtractVideo');
				hiddenVid.src = this.videoSrc;
				hiddenVid.onloadedmetadata = () => {
					this.duration = hiddenVid.duration;
					this.videoWidth = hiddenVid.videoWidth;
					this.videoHeight = hiddenVid.videoHeight;
					this.startTime = 0;
					this.endTime = parseFloat(hiddenVid.duration.toFixed(2));
					this.useFullVideo = true;
				};
			},

			clearVideo() {
				if (this.videoSrc) {
					URL.revokeObjectURL(this.videoSrc);
				}
				this.videoFile = null;
				this.videoSrc = '';
				this.duration = 0;
				this.videoWidth = 0;
				this.videoHeight = 0;
				this.frames = [];
				this.isExtracting = false;
			},

			onMainVideoTimeUpdate() {
				const video = this.$refs.mainVideo;
				if (video) {
					this.currentVideoTime = video.currentTime;
				}
			},

			formatDuration(seconds, withMs = false) {
				if (isNaN(seconds) || seconds < 0) seconds = 0;
				const mins = Math.floor(seconds / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 100);
				const mStr = String(mins).padStart(2, '0');
				const sStr = String(secs).padStart(2, '0');
				if (withMs) {
					const msStr = String(ms).padStart(2, '0');
					return `${mStr}:${sStr}.${msStr}`;
				}
				return `${mStr}:${sStr}`;
			},

			formatSize(bytes) {
				if (!bytes || bytes <= 0) return '0 B';
				if (bytes < 1024) return bytes + ' B';
				if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
				return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
			},

			getMime() {
				const map = {
					webp: 'image/webp',
					png:  'image/png',
					jpg:  'image/jpeg',
					bmp:  'image/bmp'
				};
				return map[this.targetFormat] || 'image/webp';
			},

			getExt() {
				return this.targetFormat === 'jpg' ? 'jpg' : this.targetFormat;
			},

			// Extract single snapshot from current main video player position
			captureCurrentFrame() {
				const mainVideo = this.$refs.mainVideo;
				if (!mainVideo) return;

				const canvas = document.getElementById('extractCanvas');
				const ctx = canvas.getContext('2d');

				const scale = parseFloat(this.scalePreset);
				const targetW = Math.round(this.videoWidth * scale);
				const targetH = Math.round(this.videoHeight * scale);

				canvas.width = targetW;
				canvas.height = targetH;
				ctx.drawImage(mainVideo, 0, 0, targetW, targetH);

				const mime = this.getMime();
				const q = this.isLossy ? this.quality : undefined;
				const dataUrl = canvas.toDataURL(mime, q);
				const b64 = dataUrl.split(',')[1] || '';
				const size = Math.round(b64.length * 0.75);

				const baseName = (this.videoFile?.name || 'video').replace(/\.[^/.]+$/, '');
				const tStr = this.formatDuration(mainVideo.currentTime, true).replace(':', '-').replace('.', '_');
				const ext = this.getExt();
				const filename = `${baseName}_snap_${tStr}.${ext}`;

				this.frames.unshift({
					id: Date.now() + Math.random(),
					dataUrl,
					timestamp: mainVideo.currentTime,
					width: targetW,
					height: targetH,
					size,
					filename
				});

				this.showToast('Snapshot captured!');
			},

			// Main batch extraction routine
			async startExtraction() {
				if (this.isExtracting || this.duration <= 0) return;

				this.isExtracting = true;
				this.isCancelled = false;
				this.progressPercent = 0;
				this.progressText = 'Preparing frames...';

				const timestamps = this.generateTimestamps();
				const total = timestamps.length;
				if (total === 0) {
					this.isExtracting = false;
					return;
				}

				const hiddenVid = document.getElementById('hiddenExtractVideo');
				const canvas = document.getElementById('extractCanvas');
				const ctx = canvas.getContext('2d');

				const scale = parseFloat(this.scalePreset);
				const targetW = Math.round(this.videoWidth * scale);
				const targetH = Math.round(this.videoHeight * scale);

				canvas.width = targetW;
				canvas.height = targetH;

				const baseName = (this.videoFile?.name || 'video').replace(/\.[^/.]+$/, '');
				const ext = this.getExt();
				const mime = this.getMime();
				const q = this.isLossy ? this.quality : undefined;

				const newFrames = [];

				for (let i = 0; i < total; i++) {
					if (this.isCancelled) break;

					const t = timestamps[i];
					this.progressPercent = ((i) / total) * 100;
					this.progressText = `Extracting frame ${i + 1} of ${total} (${this.formatDuration(t, true)})...`;

					// Seek video to timestamp t and wait for seeked event
					await this.seekVideoToTime(hiddenVid, t);

					ctx.drawImage(hiddenVid, 0, 0, targetW, targetH);
					const dataUrl = canvas.toDataURL(mime, q);
					const b64 = dataUrl.split(',')[1] || '';
					const size = Math.round(b64.length * 0.75);

					const idxStr = String(i + 1).padStart(3, '0');
					const tStr = this.formatDuration(t, true).replace(':', '-').replace('.', '_');
					const filename = `${baseName}_frame_${idxStr}_${tStr}.${ext}`;

					newFrames.push({
						id: Date.now() + Math.random() + i,
						dataUrl,
						timestamp: t,
						width: targetW,
						height: targetH,
						size,
						filename
					});
				}

				this.frames = newFrames;
				this.progressPercent = 100;
				this.progressText = 'Done!';
				this.isExtracting = false;
				this.showToast(`Extracted ${this.frames.length} frames!`);
			},

			generateTimestamps() {
				const { start, end, range } = this.effectiveRange;
				const list = [];

				if (this.mode === 'interval') {
					const step = Math.max(0.05, this.intervalSeconds);
					for (let t = start; t <= end + 0.001; t += step) {
						list.push(Math.min(end, parseFloat(t.toFixed(3))));
					}
				} else if (this.mode === 'total') {
					const count = Math.max(1, this.totalFramesCount);
					if (count === 1) {
						list.push(start);
					} else {
						const step = range / (count - 1);
						for (let i = 0; i < count; i++) {
							const t = start + (i * step);
							list.push(Math.min(end, parseFloat(t.toFixed(3))));
						}
					}
				} else if (this.mode === 'fps') {
					const fps = Math.max(0.1, this.fpsRate);
					const step = 1 / fps;
					for (let t = start; t <= end + 0.001; t += step) {
						list.push(Math.min(end, parseFloat(t.toFixed(3))));
					}
				}

				return list;
			},

			seekVideoToTime(video, time) {
				return new Promise((resolve) => {
					let resolved = false;
					const onSeeked = () => {
						if (!resolved) {
							resolved = true;
							video.removeEventListener('seeked', onSeeked);
							resolve();
						}
					};

					video.addEventListener('seeked', onSeeked, { once: true });
					video.currentTime = time;

					// Safety timeout in case seeked doesn't fire
					setTimeout(() => {
						if (!resolved) {
							resolved = true;
							video.removeEventListener('seeked', onSeeked);
							resolve();
						}
					}, 800);
				});
			},

			cancelExtraction() {
				this.isCancelled = true;
				this.isExtracting = false;
				this.progressText = 'Extraction cancelled.';
			},

			removeFrame(index) {
				this.frames.splice(index, 1);
			},

			clearFrames() {
				this.frames = [];
			},

			downloadSingle(frame) {
				if (!frame) return;
				const a = document.createElement('a');
				a.href = frame.dataUrl;
				a.download = frame.filename;
				a.click();
			},

			async copyToClipboard(frame) {
				if (!frame) return;
				try {
					// Browsers require image/png blob for ClipboardItem
					const img = new Image();
					img.onload = () => {
						const canvas = document.createElement('canvas');
						canvas.width = frame.width;
						canvas.height = frame.height;
						const ctx = canvas.getContext('2d');
						ctx.drawImage(img, 0, 0);
						canvas.toBlob((blob) => {
							if (blob) {
								navigator.clipboard.write([
									new ClipboardItem({ 'image/png': blob })
								]).then(() => {
									this.showToast('Copied frame to clipboard!');
								}).catch(() => {
									this.showToast('Could not copy image');
								});
							}
						}, 'image/png');
					};
					img.src = frame.dataUrl;
				} catch (e) {
					console.error('Clipboard copy failed:', e);
					this.showToast('Clipboard copy not supported');
				}
			},

			async downloadZip() {
				if (this.frames.length === 0 || this.isZipping) return;
				this.isZipping = true;
				this.zipProgressText = 'Loading ZIP tool...';

				try {
					await window.__jszipLoaded;
					const zip = new JSZip();
					const baseName = (this.videoFile?.name || 'video').replace(/\.[^/.]+$/, '');
					const folder = zip.folder(`${baseName}-frames`) || zip;

					this.zipProgressText = 'Packing frames (0%)...';

					for (let i = 0; i < this.frames.length; i++) {
						const f = this.frames[i];
						const b64Data = f.dataUrl.split(',')[1];
						folder.file(f.filename, b64Data, { base64: true });
						this.zipProgressText = `Packing ${i + 1}/${this.frames.length}...`;
					}

					this.zipProgressText = 'Generating ZIP...';
					const content = await zip.generateAsync({ type: 'blob' }, (metadata) => {
						this.zipProgressText = `Compressing ${Math.round(metadata.percent)}%...`;
					});

					const url = URL.createObjectURL(content);
					const a = document.createElement('a');
					a.href = url;
					a.download = `${baseName}-frames.zip`;
					a.click();
					URL.revokeObjectURL(url);
					this.showToast('ZIP downloaded successfully!');
				} catch (err) {
					console.error('ZIP generation error:', err);
					alert('Failed to generate ZIP archive. You can download frames separately.');
				} finally {
					this.isZipping = false;
					this.zipProgressText = '';
				}
			},

			downloadAllSequential() {
				this.frames.forEach((frame, idx) => {
					setTimeout(() => {
						this.downloadSingle(frame);
					}, idx * 150);
				});
				this.showToast(`Downloading ${this.frames.length} files...`);
			},

			// Modal functions
			openModal(index) {
				this.activeModalIndex = index;
				this.modalOpen = true;
			},

			prevModalImage() {
				if (this.activeModalIndex > 0) {
					this.activeModalIndex--;
				}
			},

			nextModalImage() {
				if (this.activeModalIndex < this.frames.length - 1) {
					this.activeModalIndex++;
				}
			}
		}));
	});
	</script>
</Layout>
